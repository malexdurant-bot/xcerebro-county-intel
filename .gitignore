# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
venv/
.venv/
env/
ENV/

# Node (for any tooling layered on top)
node_modules/
npm-debug.log*

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo

# Build artifacts that DO NOT belong in version control
# (Phase 1+ may generate these; tracked separately by run manifests)
data/raw/
data/cache/
data/exports/
data/runs/*/raw/
data/evidence/*.pdf

# Per-county run logs and transient artifacts
# The runs/<slug>/ folder itself IS committed (launch files, manifests, notes).
# But per-county logs and generated pipeline output are scratch, not committed.
runs/*/logs/
runs/*/tmp/
runs/*/.cache/
runs/*/pipeline_output/

# Debug probe artifacts — HTML captures and API response dumps (may contain live data)
runs/*/debug_*.html
runs/*/debug_*.json

# Config temp files generated by atomic-write pattern
config/counties/*.tmp.json

# Generated dashboard payload (live data — not committed)
dashboard/data/

# Secrets — never commit
.env
.env.*
!.env.example
secrets/
*.pem
*.key

# Coverage / test artifacts
.coverage
htmlcov/
.tox/
